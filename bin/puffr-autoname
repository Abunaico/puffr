#!/usr/bin/env node
// puffr autoname — names a session ACCOUNT-CATEGORY-PROJ-TASK-SUB from its first prompts.
// As a UserPromptSubmit hook it records the first 5 real prompts. After the 3rd and
// the 5th it starts a background Haiku call (so no prompt ever waits on it), and the
// next prompt applies the result via hookSpecificOutput.sessionTitle. Vocabulary
// comes from the user's own past titles in the puffr-sessions cache. A title the user
// set (/rename, or a resumed named session) always wins: autoname then stands down.
//
// Usage: puffr-autoname hook                         (stdin: UserPromptSubmit payload)
//        puffr-autoname generate <session-id>        (background worker)
//        puffr-autoname suggest [--cwd <dir>] <prompt>...   print a name, apply nothing
// Off switch: `autoname=off` in ~/.puffr/config, or /puffr:off.
// The same hook also carries the opt-in cold-return guard (`guard.cold=on`, see coldWarning):
// one node process per prompt, one JSON document on stdout, and neither half can break the other.
'use strict';
const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawn, spawnSync } = require('child_process');

const DIR = path.join(os.homedir(), '.puffr');
const STATE_DIR = path.join(DIR, 'autoname');
const CACHE = path.join(DIR, 'sessions-cache.json');
const GEN_AT = [3, 5];
const MAX_PROMPTS = 5;
const MAX_CALLS = 15;           // stop reading the transcript tail after this many prompts
const ID = /^[A-Za-z0-9-]{8,64}$/;

const clean = s => String(s || '').replace(/[\x00-\x08\x0b-\x1f\x7f-\x9f]/g, '');

function configHas(re) {
  try { return re.test(fs.readFileSync(path.join(DIR, 'config'), 'utf8')); } catch { return false; }
}
const muted = () => fs.existsSync(path.join(DIR, 'disabled'));
const isOff = () => muted() || configHas(/^\s*autoname\s*=\s*off\s*$/m);
const guardOn = () => !muted() && configHas(/^\s*guard\.cold\s*=\s*on\s*$/m);

function readJSON(f) { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch { return null; } }
function writeJSON(f, v) {
  fs.mkdirSync(STATE_DIR, { recursive: true, mode: 0o700 });
  const tmp = `${f}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, JSON.stringify(v), { mode: 0o600 });
  fs.renameSync(tmp, f);
}
const statePath = id => path.join(STATE_DIR, `${id}.json`);
// The worker writes only this file and the hook writes only the state file, so they never race.
const pendingPath = id => path.join(STATE_DIR, `${id}.pending`);

// Slash commands alone ("/puffr:on") say nothing about the task, so they don't count.
function isReal(p) { return p.length > 0 && !/^\/[\w:.-]+$/.test(p); }

function lastCustomTitle(file) {
  if (!file) return null;
  let fd;
  try {
    fd = fs.openSync(file, 'r');
    const size = fs.fstatSync(fd).size, len = Math.min(size, 1 << 20);
    const buf = Buffer.alloc(len);
    fs.readSync(fd, buf, 0, len, size - len);
    const lines = buf.toString('utf8').split('\n');
    for (let i = lines.length - 1; i >= 0; i--) {
      if (!lines[i].includes('"custom-title"')) continue;
      try { const e = JSON.parse(lines[i]); if (e.type === 'custom-title') return e.customTitle || null; } catch {}
    }
  } catch {} finally { if (fd !== undefined) fs.closeSync(fd); }
  return null;
}

// Cold-return guard. Warns once per cold period, never blocks, and costs nothing when off.
const COLD_TOKENS = 100000;     // warn only when the context to rewrite is larger than this
const TAIL_BYTES = 262144;      // transcript tail read, as statusline.sh does
const GUARD_DIR = path.join(DIR, 'guard');

// Last real assistant row in the tail, with the facts the warning needs. Null when anything is missing.
function lastAssistant(file) {
  let fd;
  try {
    fd = fs.openSync(file, 'r');
    const size = fs.fstatSync(fd).size, len = Math.min(size, TAIL_BYTES);
    const buf = Buffer.alloc(len);
    fs.readSync(fd, buf, 0, len, size - len);
    const lines = buf.toString('utf8').split('\n');
    let compacted = false, last = null, tier = null;
    for (let i = lines.length - 1; i >= 0; i--) {
      const l = lines[i];
      const isBoundary = l.includes('compact_boundary'), isAsst = /"type": ?"assistant"/.test(l);
      if (!isBoundary && !isAsst) continue;
      let e; try { e = JSON.parse(l); } catch { continue; }
      if (!last && e.type === 'system' && e.subtype === 'compact_boundary') { compacted = true; continue; }
      const m = e.type === 'assistant' && !e.isSidechain && e.message;
      const u = m && m.usage;
      if (!u || typeof m.model !== 'string' || m.model === '<synthetic>') continue;
      if (!last) last = { model: m.model, at: e.timestamp, u };
      if (tier === null && Number(u.cache_creation_input_tokens) > 0) {
        tier = Number(u.cache_creation && u.cache_creation.ephemeral_1h_input_tokens) > 0 ? 3600 : 300;
      }
      if (last && tier !== null) break;
    }
    return last && tier !== null ? { ...last, tier, compacted } : null;
  } catch { return null; } finally { if (fd !== undefined) try { fs.closeSync(fd); } catch {} }
}

const modelName = m => { const x = /(opus|sonnet|haiku|fable|mythos)-(\d+)(?:-(\d{1,2}))?(?!\d)/.exec(m); return x ? `${x[1][0].toUpperCase()}${x[1].slice(1)} ${x[2]}${x[3] ? '.' + x[3] : ''}` : clean(m).slice(0, 40); };

// Returns the warning text, or null. A missing or odd field means null, never a guess.
function coldWarning(ev) {
  const id = ev && ev.session_id;
  if (!ID.test(String(id)) || typeof ev.transcript_path !== 'string' || !ev.transcript_path) return null;
  const a = lastAssistant(ev.transcript_path);
  if (!a || a.compacted) return null;
  const at = Date.parse(a.at), n = k => Number(a.u[k]) || 0;
  const ctx = n('input_tokens') + n('cache_read_input_tokens') + n('cache_creation_input_tokens');
  if (!Number.isFinite(at) || !(ctx > COLD_TOKENS) || !(Date.now() > at + a.tier * 1000)) return null;
  const stateFile = path.join(GUARD_DIR, `${id}.json`), prior = readJSON(stateFile);
  if (prior && prior.warnedFor === a.at) return null;
  fs.mkdirSync(GUARD_DIR, { recursive: true, mode: 0o700 });
  const tmp = `${stateFile}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, JSON.stringify({ warnedFor: a.at }), { mode: 0o600 });
  fs.renameSync(tmp, stateFile);
  // Loaded only now, so the off path and the warm path never pay for it.
  const lib = require(path.join(__dirname, '..', 'lib', 'puffr.js'));
  const p = lib.price(a.model);
  let cost = '';
  if (p) {
    // rewriteCost is the extra over a warm read; add the read back for the full rewrite.
    const full = lib.rewriteCost(a.model, a.tier === 300 ? ctx : 0, a.tier === 3600 ? ctx : 0) + ctx * p.r / 1e6;
    cost = ` about $${full.toFixed(2)} (list price, ${modelName(a.model)}, ${a.tier === 3600 ? '1h' : '5m'})`;
  }
  return `puffr: cache cold on this ${Math.round(ctx / 1000)}k session; next turn rewrites it${cost || ` (${a.tier === 3600 ? '1h' : '5m'} cache)`}. Consider /compact or /clear.`;
}

// Autoname's half of the hook: returns the title to apply, or null.
function autonameStep(ev) {
  const id = ev && ev.session_id;
  if (!ID.test(String(id))) return null;
  const st = readJSON(statePath(id)) || { prompts: [], generated: [], applied: null, appliedFrom: 0, calls: 0, done: false };
  if (st.done) return null;
  st.cwd = ev.cwd || st.cwd;
  st.calls++;

  const current = lastCustomTitle(ev.transcript_path);
  const pending = readJSON(pendingPath(id));
  if (current && current !== st.applied && !(pending && current === pending.title)) {
    st.done = true; writeJSON(statePath(id), st); return null;
  }

  const p = clean(ev.prompt).trim();
  if (st.prompts.length < MAX_PROMPTS && isReal(p)) st.prompts.push(p.slice(0, 800));

  let out = null;
  if (pending && pending.title && pending.title !== st.applied) {
    out = st.applied = pending.title; st.appliedFrom = pending.from;
  }
  const n = st.prompts.length;
  if (GEN_AT.includes(n) && !st.generated.includes(n)) {
    st.generated.push(n);
    spawn(process.execPath, [__filename, 'generate', id], { detached: true, stdio: 'ignore' }).unref();
  }
  if (st.appliedFrom >= MAX_PROMPTS || st.calls >= MAX_CALLS) st.done = true;
  writeJSON(statePath(id), st);
  return out;
}

// The guard runs first and in its own try, so autoname finishing, standing down or failing
// cannot silence it, and a guard failure cannot change autoname's title or exit status.
function hook() {
  if (process.env.PUFFR_AUTONAME_CHILD || muted()) return;
  const guard = guardOn(), names = !isOff();
  if (!guard && !names) return;
  let ev; try { ev = JSON.parse(fs.readFileSync(0, 'utf8')); } catch { return; }
  let warn = null, title = null;
  if (guard) { try { warn = coldWarning(ev); } catch {} }
  if (names) { try { title = autonameStep(ev); } catch {} }
  const o = {};
  if (warn) o.systemMessage = warn;
  if (title) o.hookSpecificOutput = { hookEventName: 'UserPromptSubmit', sessionTitle: title };
  if (warn || title) process.stdout.write(JSON.stringify(o));
}

function pastTitles(exceptId) {
  const raw = readJSON(CACHE) || {}, cache = raw.files || raw;   // v2+ caches nest entries under files
  const seen = new Map(), recent = new Set(), cutoff = Date.now() - 3 * 864e5;
  for (const [file, ent] of Object.entries(cache)) {
    const s = ent && ent.state; if (!s || !s.customTitle) continue;
    if (exceptId && file.endsWith(`${exceptId}.jsonl`)) continue;
    const t = clean(s.customTitle).trim(), last = Date.parse(s.last) || 0;
    if (t.length < 3 || t !== t.toUpperCase()) continue;
    if (last > cutoff) recent.add(t);
    if (!seen.has(t) || seen.get(t).last < last) seen.set(t, { last, cwd: clean(s.cwd) });
  }
  const examples = [...seen].sort((a, b) => b[1].last - a[1].last).slice(0, 60)
    .map(([t, v]) => `${t} — ${v.cwd || '?'}`);
  return { examples, recent: [...recent] };
}

function buildPrompt({ cwd, prompts, current, examples, recent }) {
  return [
    'You name Claude Code sessions for one user. Reply with ONLY the name, nothing else.',
    '',
    'Format: ACCOUNT-CATEGORY-PROJ-TASK-SUB. Uppercase letters and digits, segments joined by single hyphens.',
    'Drop any segment that does not apply (2 to 5 segments). Each segment is one word or a tight abbreviation.',
    '- ACCOUNT: who the work is for, a short code for the client or org folder (an acme folder → ACME). Abunaico folders → ACO.',
    '  A personal project outside those (e.g. swingr) has no account segment: start with the project name.',
    '- CATEGORY: the kind of work, e.g. BD, PLAYBOOK, HARNESS, CREATIVE, BIZ, OS, WEB.',
    '- PROJ: the engagement, client, product or tool.',
    '- TASK: what this session is doing.',
    '- SUB: only for a sub-task, or to tell this apart from another session doing the same thing.',
    "Reuse the user's vocabulary below and match their spelling of accounts, categories and projects.",
    '',
    "The user's past session names (name — folder):",
    ...examples,
    '',
    'Names other sessions used in the last 3 days. Never repeat one exactly; add a SUB segment instead:',
    recent.join(', ') || '(none)',
    '',
    `This session's folder: ${cwd || '?'}`,
    current ? `Current name: ${current}. Keep it unless the prompts show it is wrong; you may add a SUB segment.` : '',
    '',
    "The session's first prompts:",
    ...prompts.map((p, i) => `${i + 1}. ${p.replace(/\s+/g, ' ')}`),
  ].join('\n');
}

function normalize(raw) {
  const line = String(raw || '').split('\n').map(s => s.trim()).filter(Boolean).pop() || '';
  const segs = line.toUpperCase().replace(/[^A-Z0-9]+/g, '-').split('-').filter(Boolean)
    .slice(0, 5).map(s => s.slice(0, 16));
  let t = segs.join('-');
  while (t.length > 48 && segs.length > 1) { segs.pop(); t = segs.join('-'); }
  return t;
}

function dedupe(title, taken) {
  if (!taken.has(title)) return title;
  for (let i = 2; ; i++) if (!taken.has(`${title}-${i}`)) return `${title}-${i}`;
}

function nameFor({ cwd, prompts, current, exceptId }) {
  const { examples, recent } = pastTitles(exceptId);
  const bin = process.env.PUFFR_AUTONAME_CLAUDE
    || (process.env.CLAUDE_CODE_EXECPATH && fs.existsSync(process.env.CLAUDE_CODE_EXECPATH) ? process.env.CLAUDE_CODE_EXECPATH : 'claude');
  // No settings sources, MCP, tools or skills: no hooks fire in the child, so it can't recurse or slow down.
  const r = spawnSync(bin, ['-p', '--model', 'haiku', '--no-session-persistence', '--setting-sources', '',
    '--strict-mcp-config', '--tools', '', '--disable-slash-commands'], {
    input: buildPrompt({ cwd, prompts, current, examples, recent }),
    encoding: 'utf8', timeout: 60000, cwd: os.tmpdir(),
    env: { ...process.env, PUFFR_AUTONAME_CHILD: '1' },
  });
  if (r.status !== 0) return null;
  const t = normalize(r.stdout);
  if (!t) return null;
  const taken = new Set(recent); if (current) taken.delete(current);
  return dedupe(t, taken);
}

function generate(id) {
  if (!ID.test(String(id))) return;
  const st = readJSON(statePath(id)); if (!st || !st.prompts.length) return;
  const title = nameFor({ cwd: st.cwd, prompts: st.prompts, current: st.applied, exceptId: id });
  if (title) writeJSON(pendingPath(id), { title, from: st.prompts.length });
}

const [cmd, ...rest] = process.argv.slice(2);
if (cmd === 'hook') { try { hook(); } catch {} process.exit(0); }
else if (cmd === 'generate') { try { generate(rest[0]); } catch {} }
else if (cmd === 'suggest') {
  let cwd = process.cwd();
  if (rest[0] === '--cwd') { cwd = rest[1]; rest.splice(0, 2); }
  const t = nameFor({ cwd, prompts: rest.map(clean) });
  if (!t) { console.error('puffr-autoname: no name came back'); process.exit(1); }
  console.log(t);
} else { console.error('usage: puffr-autoname hook | generate <id> | suggest [--cwd dir] <prompt>...'); process.exit(2); }
